{
  "name": "@harness/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "backfill:actors": "tsx scripts/backfill-actors.ts",
    "seed:metrics-checkpoint": "tsx scripts/seed-metrics-window.ts",
    "seed:e2e-fixture": "tsx scripts/seed-e2e-fixture.ts"
  },
  "dependencies": {
    "@harness/agent-runtime": "workspace:*",
    "@harness/artifact-tracker": "workspace:*",
    "@harness/attention-engine": "workspace:*",
    "@harness/auth": "workspace:*",
    "@harness/context-engine": "workspace:*",
    "@harness/db": "workspace:*",
    "@harness/di": "workspace:*",
    "@harness/domain": "workspace:*",
    "@harness/embeddings": "workspace:*",
    "@harness/evaluation": "workspace:*",
    "@harness/event-bus": "workspace:*",
    "@harness/git-provider": "workspace:*",
    "@harness/mcp": "workspace:*",
    "@harness/orchestrator": "workspace:*",
    "@harness/observability": "workspace:*",
    "@harness/object-store": "workspace:*",
    "@harness/review": "workspace:*",
    "@harness/sandbox": "workspace:*",
    "@harness/ticket-provider": "workspace:*",
    "@harness/verification-engine": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}