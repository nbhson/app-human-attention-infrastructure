{
  "name": "harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "pnpm --filter @harness/db migrate && pnpm --filter @harness/api exec tsx scripts/e2e-happy-path.ts && pnpm --filter @harness/api exec tsx scripts/e2e-failure-paths.ts",
    "load:smoke": "pnpm --filter @harness/db migrate && pnpm --filter @harness/api exec tsx scripts/load-smoke.ts",
    "audit:orphans": "pnpm --filter @harness/db audit:orphans",
    "eval:metrics": "pnpm --filter @harness/evaluation eval:metrics",
    "eval:report": "pnpm --filter @harness/evaluation eval:report",
    "dev": "turbo run dev",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.16.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-boundaries": "^5.4.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.1",
    "simple-git-hooks": "^2.11.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.17.0",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  }
}