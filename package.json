{
  "name": "harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "vitest run --config e2e/vitest.config.ts",
    "audit:orphans": "pnpm --filter @harness/db audit:orphans",
    "seed:metrics-checkpoint": "pnpm --filter @harness/api seed:metrics-checkpoint",
    "seed:e2e-fixture": "pnpm --filter @harness/api seed:e2e-fixture",
    "demo:mcp-connectivity": "pnpm --filter @harness/api demo:mcp-connectivity",
    "demo:memory": "pnpm --filter @harness/api demo:memory",
    "demo:writeback-toggle": "pnpm --filter @harness/api demo:writeback-toggle",
    "demo:writeback": "pnpm --filter @harness/api demo:writeback",
    "eval:metrics": "pnpm --filter @harness/evaluation eval:metrics",
    "eval:report": "pnpm --filter @harness/evaluation eval:report",
    "eval:replay": "pnpm --filter @harness/evaluation eval:replay",
    "eval:ab": "pnpm --filter @harness/evaluation eval:ab",
    "eval:make-dataset": "pnpm --filter @harness/evaluation eval:make-dataset",
    "eval:fit": "pnpm --filter @harness/evaluation eval:fit",
    "calibration:report": "pnpm --filter @harness/api calibration:report",
    "embed:populate": "pnpm --filter @harness/embeddings embed:populate",
    "dev": "turbo run dev",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.16.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-boundaries": "^5.4.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.1",
    "simple-git-hooks": "^2.11.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.17.0",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  }
}