DATABASE_URL=postgres://harness:harness@localhost:5432/harness
ANTHROPIC_API_KEY=your-key-here
# --- Phase 1 · Week 2: Git/ticket providers (REST, review-reorient) ---
GITHUB_TOKEN=your-github-token-here
GITHUB_BASE_URL=https://api.github.com
JIRA_TOKEN=your-jira-token-here
JIRA_BASE_URL=https://your-site.atlassian.net
# --- Phase 3 · Week 1: MCP tool connectivity (day-02) ---
# Referenced by mcp.config.json as `tokenEnv`. The harness never stores these —
# it only checks presence and surfaces the last-4 hint in the settings UI.
GITLAB_TOKEN=your-gitlab-token-here
BITBUCKET_TOKEN=your-bitbucket-token-here
# Optional: override where the harness looks for mcp.config.json (default: repo root).
# MCP_CONFIG_PATH=./mcp.config.json
# --- Phase 3 · Week 2: write-back toggles (day-09) ---
# Write-back is ON by default; each layer can still opt a write out:
#   1. Global ceiling:  WRITEBACK_ENABLED=0  disables it fleet-wide (unset ⇒ ON).
#   2. Per-provider:    WRITEBACK_GITHUB=0 / WRITEBACK_GITLAB=0 / WRITEBACK_BITBUCKET=0 /
#                       WRITEBACK_JIRA=0  (unset ⇒ ON per host).
#   3. Request flag:    omit `writeback: true` on the decision payload (the human's
#                       per-decision choice; the review UI ticks it by default).
# No live tokens are stored in this file — the harness only checks these flags
# against the MCP servers configured in mcp.config.json.
# WRITEBACK_ENABLED=0
# WRITEBACK_GITHUB=0
# --- Phase 2 · Week 4: semantic embeddings (day-16) ---
# Unset → the deterministic StubEmbedder (no external provider). Set to switch to
# a real OpenAI-compatible embeddings endpoint (dimension is fixed at 1536):
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=text-embedding-3-small
# --- Phase 2 · Week 5: object store (day-21) ---
# Unset → snapshot content stays inline in Postgres (the Phase-1 default; no
# object offload happens). Set OBJECT_STORE_ENDPOINT to write large (>1 MiB)
# snapshots to S3/MinIO instead, keyed by content hash; readers resolve them back
# through the ContentStore seam.
# OBJECT_STORE_ENDPOINT=http://localhost:9000
# OBJECT_STORE_BUCKET=harness-artifacts
# OBJECT_STORE_REGION=us-east-1
# OBJECT_STORE_ACCESS_KEY_ID=minioadmin
# OBJECT_STORE_SECRET_ACCESS_KEY=minioadmin
# OBJECT_STORE_PREFIX=artifacts/
# OBJECT_STORE_THRESHOLD_BYTES=1048576
# --- Phase 2 · Week 1: identity (day-01) ---
# Mock IdP for local dev/demo:
OIDC_MOCK=true
MOCK_OIDC_SUB=mock|local-user
MOCK_OIDC_EMAIL=local@example.com
MOCK_OIDC_NAME=Local Reviewer
# Real IdP (set OIDC_MOCK=false and these):
# OIDC_ISSUER_URL=https://your-idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# JWT signing secret — never commit a real one:
JWT_SECRET=dev-only-insecure-secret
COOKIE_SECURE=false
APP_URL=http://localhost:3000
# --- Phase 3 · Week 7: durable queue transport (day-34) ---
# Optional swap behind the same IEventBus contract. Unset → inproc (the zero-config
# in-memory bus). `redis`/`sqs` require the operator to supply a StreamTransport
# adapter (the repo ships none — live brokers are opt-in), so a durable deploy opts
# in deliberately. Default is `inproc`; the hot path is unchanged while it is selected.
# EVENT_TRANSPORT=inproc