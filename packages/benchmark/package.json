{
  "name": "@harness/benchmark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('node:fs');fs.mkdirSync('dist/seed',{recursive:true});fs.copyFileSync('src/seed/examples.json','dist/seed/examples.json')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/benchmark"
  },
  "dependencies": {
    "@harness/domain": "workspace:^",
    "@harness/db": "workspace:^",
    "@harness/judge": "workspace:^",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
