{
  "name": "@harness/evaluation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/evaluation",
    "eval:metrics": "tsx src/cli.ts",
    "eval:report": "tsx src/report-cli.ts",
    "eval:replay": "tsx src/replay-cli.ts",
    "eval:ab": "tsx src/ab-cli.ts",
    "eval:ab-report": "tsx src/ab/ab-report.ts",
    "eval:make-dataset": "tsx src/make-dataset-cli.ts",
    "eval:fit": "tsx src/fit-cli.ts"
  },
  "dependencies": {
    "@harness/domain": "workspace:^",
    "@harness/db": "workspace:^",
    "@harness/di": "workspace:^",
    "@harness/observability": "workspace:^",
    "drizzle-orm": "^0.45.2",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
